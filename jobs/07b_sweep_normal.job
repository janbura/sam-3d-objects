#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_sweep_normal
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --output=logs/sam_sweep_normal_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export LIDRA_SKIP_INIT=1

mkdir -p logs

echo "=== GPU ==="
nvidia-smi
python -c "import torch; print('CUDA:', torch.cuda.is_available(), '/', torch.cuda.get_device_name(0))"

echo ""
echo "=== Normal sweep (3 configs x 85 instances, ~1.8h) ==="
time python scripts/sweep.py \
    --instances misc/tune_85.txt \
    --configs normal_1.0 normal_5.0 normal_10.0 \
    --seed 42

echo ""
echo "=== 07b_sweep_normal DONE ==="
