#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_viz_pose
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/sam_viz_pose_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export LIDRA_SKIP_INIT=1

mkdir -p logs outputs

echo "=== Pose comparison visualization (sweet-spot instances) ==="
python -u scripts/viz_pose_comparison.py \
    --device cuda \
    --out outputs/viz_pose_cmp.png

echo "=== Done — check outputs/viz_pose_cmp.png ==="
