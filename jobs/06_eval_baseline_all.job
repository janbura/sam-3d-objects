#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_eval_baseline
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/sam_eval_baseline_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export LIDRA_SKIP_INIT=1

mkdir -p logs

echo "=== GPU ==="
nvidia-smi
python -c "import torch; print('CUDA:', torch.cuda.is_available(), '/', torch.cuda.get_device_name(0))"

echo ""
echo "=== Eval baseline_all: CD + F-score + IoU on 1709 instances ==="
time python -u scripts/eval_baseline_all.py --device cuda

echo ""
echo "=== 06_eval_baseline_all DONE ==="
echo "Results saved to outputs/baseline_all/results_multi_init.csv"
