#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_sweep_combo
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/sam_sweep_combo_%j.out

# Vibe-check composite guidance on 17 stratified instances.
# Override at submit time:
#   sbatch --export=ALL,CONFIGS=pose_ss                jobs/15_sweep_combos.job
#   sbatch --export=ALL,CONFIGS=pose_depth_normal      jobs/15_sweep_combos.job
#   sbatch --export=ALL,CONFIGS=pose_ss_depth_normal   jobs/15_sweep_combos.job

CONFIGS=${CONFIGS:-"pose_ss_depth_normal"}
INSTANCES=${INSTANCES:-"misc/combo_17.txt"}

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export LIDRA_SKIP_INIT=1

mkdir -p logs

echo "=== GPU ==="
nvidia-smi
python -c "import torch; print('CUDA:', torch.cuda.is_available(), '/', torch.cuda.get_device_name(0))"

echo ""
echo "=== Combo sweep  configs=${CONFIGS}  instances=${INSTANCES} ==="
time python -u scripts/sweep.py \
    --instances "${INSTANCES}" \
    --configs ${CONFIGS} \
    --seed 42

echo ""
echo "=== 15_sweep_combos DONE ==="
