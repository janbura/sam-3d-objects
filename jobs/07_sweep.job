#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=sam_sweep_tune85
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=logs/sam_sweep_tune85_%j.out

set -eo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2
module load CUDA/12.1.1 2>/dev/null || true

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3d-objects

cd "$HOME/sam-3d-objects"
export LIDRA_SKIP_INIT=1

mkdir -p logs

# depth/normal first (cheap ~25s/inst), ss last (heavy ~150s/inst), pose last (2x heavy)
# sweep.py skips already-done instances — safe to resubmit if timeout
CONFIGS="depth_2.0 depth_5.0 normal_2.0 normal_5.0 ss_2.0 ss_5.0 ss_10.0 pose_0.05 pose_0.2"

echo "=== GPU ==="
nvidia-smi
python -c "import torch; print('CUDA:', torch.cuda.is_available(), '/', torch.cuda.get_device_name(0))"

echo ""
echo "=== Guidance sweep on 85-instance stratified dev set ==="
echo "Configs: $CONFIGS"
echo ""
time python scripts/sweep.py --instances misc/tune_85.txt --configs $CONFIGS --seed 42

echo ""
echo "=== Eval: CD + mask IoU across all configs ==="
python scripts/eval_sweep.py \
    --instances misc/tune_85.txt \
    --device cuda

echo ""
echo "=== 07_sweep_tune85 DONE ==="
