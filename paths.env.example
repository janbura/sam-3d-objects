# Personal paths — sourced by every job in jobs/.
#
# A fresh clone has NO paths.env (it is gitignored). Copy this template and edit
# the values for your account:
#
#   cp paths.env.example paths.env
#
# The defaults below are safe for a fresh Snellius account; adjust if your
# home/scratch layout differs.

export SAM3D_REPO="$HOME/sam-3d-objects"

# Conda env location. Keep this on $HOME, NOT /scratch-shared: scratch-shared is
# auto-purged after ~14 days of inactivity, which silently corrupts the env and
# breaks the compiled CUDA extensions. $HOME is persistent.
export SAM3D_CONDA_ENVS="$HOME/conda_envs"
export SAM3D_ENV_NAME="sam3d-objects"

# Checkpoints (~1.7 GB, re-downloadable). Scratch is fine here; move to $HOME if
# you want them to survive the scratch purge.
export SAM3D_CHECKPOINTS="/scratch-shared/$USER/sam3d_checkpoints"
